# ─────────────────────────────────────────────────────────────
# AK Engineering API — environment template
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8080

# Public origin of THIS API, used to build absolute asset URLs under the
# local storage driver. In production: https://api.akengg.com
PUBLIC_BASE_URL=http://localhost:8080

# Public URL of the marketing website (used for links in emails).
PUBLIC_SITE_URL=http://localhost:5173

# ── File storage ──────────────────────────────────────────────
# local = src/public/uploads on disk, served at /uploads
# s3    = objects in AWS_S3_BUCKET (see src/utils/storage.js)
STORAGE_DRIVER=local

# Only used by S3 for PUBLIC keys (a CDN in front of the bucket).
# Blank under the local driver -> PUBLIC_BASE_URL + "/uploads".
ASSET_BASE_URL=

# ── S3 (used only when STORAGE_DRIVER=s3) ─────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Leave blank on EC2/ECS to use the instance/task IAM role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Presigned URL lifetime in seconds (default 3600, AWS maximum 604800).
S3_SIGNED_URL_TTL=3600

# Comma-separated key prefixes served as plain public URLs instead of
# presigned ones. Empty = everything private.
#
# IMPORTANT: only list prefixes that are ACTUALLY public-readable in the bucket
# policy (see docs/s3-bucket-policy.json) — otherwise these URLs return 403.
# Apply the bucket policy BEFORE setting this value.
#
# Website imagery belongs here: presigned URLs expire, which breaks social
# previews, image indexing and browser/CDN caching. Keep "documents" OUT of
# this list — invoices must stay private.
S3_PUBLIC_FOLDERS=blogs,services,projects,team

# ── MySQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=akengg_db

# ── JWT auth ──────────────────────────────────────────────────
# Use a long random value in production.
SECRET_JWT_KEY=
JWT_EXPIRES_IN=7d

# ── Email: Brevo SMTP relay ───────────────────────────────────
# Brevo dashboard -> SMTP & API -> SMTP tab.
# SMTP_PASSWORD is the SMTP key, not the account password or the API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# MAIL_FROM_ADDRESS must be a sender verified in Brevo.
MAIL_FROM_NAME=AK Engineering
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
# Inbox(es) receiving contact-form enquiries; comma-separated for several.
MAIL_ADMIN_TO=
MAIL_COMPANY_NAME=AK Engineering
